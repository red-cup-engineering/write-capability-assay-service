{
  "name": "@red-cup-engineering/write-capability-assay-service",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "Checks one finite write-authorization bundle — office identity, scope, dispatch, digests — without touching any filesystem. Use when an office must prove it may write before writing.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/write-capability-assay-service.git"
  },
  "bin": {
    "serve-write-capability-assay-a2a": "./scripts/server.mjs"
  },
  "scripts": {
    "check": "node --check src/protocol.mjs && node --check src/assay-write-capability.mjs && node --check src/client.mjs && node --check scripts/execute-a2a-task.mjs && node --check scripts/server.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@red-cup-engineering/computer-code-engine": "^0.1.0",
    "@a2a-js/sdk": "1.0.0-beta.0",
    "@red-cup-engineering/a2a-contracted-agent-service": "^0.12.0",
    "@red-cup-engineering/a2a-rmn-part-service": "^0.5.0",
    "@red-cup-engineering/a2a-rmn-task-client-service": "^0.10.0",
    "@red-cup-engineering/relation-model-notation-json-codec": "^0.3.1",
    "@red-cup-engineering/relation-model-notation-runtime": "^0.14.0",
    "@red-cup-engineering/relation-model-notation-typing": "^0.2.2",
    "@red-cup-engineering/semantic-content-identify-service": "^0.2.19"
  },
  "license": "MIT",
  "funding": {
    "type": "individual",
    "url": "https://github.com/561-group/.github/blob/main/TIPS.md"
  }
}
